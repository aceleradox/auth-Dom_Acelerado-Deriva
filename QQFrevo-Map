<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mapa de Rolês - Frevos, Festas e Funk</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- React e ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel para JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Leaflet.heat para mapa de calor -->
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        html, body, #root { width: 100%; height: 100%; overflow: hidden; background: #1e1e2f; }
        .app-container { display: flex; width: 100%; height: 100%; position: relative; }

        /* Sidebar */
        .sidebar {
            width: 350px;
            background: #1e1e2f;
            color: #fff;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 15px;
            z-index: 1000;
            transition: transform 0.3s ease;
            height: 100%;
            flex-shrink: 0;
        }
        .sidebar.closed { transform: translateX(-100%); position: fixed; left: 0; top: 0; height: 100%; }

        .map-container {
            flex: 1;
            height: 100%;
            position: relative;
        }

        /* Botão hamburguer para mobile */
        .menu-toggle {
            display: none;
            position: fixed;
            top: 10px;
            left: 10px;
            z-index: 1100;
            background: #1e1e2f;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px;
            cursor: pointer;
            font-size: 1.2rem;
        }

        /* Modal de detalhes */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-y: auto;
        }
        .modal-content {
            background: #2d2d44;
            color: #fff;
            border-radius: 10px;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 20px;
            position: relative;
            margin: auto;
        }
        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            background: #ff6b6b;
            color: #fff;
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            cursor: pointer;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        h2 { font-size: 1.2rem; margin-bottom: 10px; color: #ff6b6b; }
        .search-box {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: none;
            margin-bottom: 10px;
            background: #2d2d44;
            color: #fff;
        }
        .search-results {
            list-style: none;
            margin-bottom: 10px;
        }
        .search-results li {
            padding: 8px;
            background: #2d2d44;
            margin-bottom: 5px;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .search-results li:hover { background: #3d3d5c; }
        .radius-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        .radius-buttons button {
            flex: 1;
            padding: 8px;
            background: #2d2d44;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .radius-buttons button.active {
            background: #ff6b6b;
            color: #000;
        }
        .info-panel {
            background: #2d2d44;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
        }
        .event-item {
            padding: 8px;
            background: #2d2d44;
            margin-bottom: 5px;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .event-item:hover { background: #3d3d5c; }
        .trend-up { color: #4caf50; }
        .trend-down { color: #f44336; }
        .stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
        .stat-card {
            background: #2d2d44;
            padding: 8px;
            border-radius: 4px;
            flex: 1;
            text-align: center;
            font-size: 0.9rem;
            min-width: 80px;
        }
        .loading { color: #ff6b6b; font-style: italic; }
        .leaflet-container { width: 100%; height: 100%; }

        .detail-section {
            margin: 10px 0;
            padding: 10px;
            background: #1e1e2f;
            border-radius: 6px;
        }
        .detail-section h3 {
            margin-bottom: 8px;
            color: #ff6b6b;
        }
        .weekly-chart {
            display: flex;
            gap: 4px;
            align-items: flex-end;
            margin-top: 5px;
            flex-wrap: wrap;
        }
        .weekly-bar {
            text-align: center;
            font-size: 0.7rem;
        }
        .bar {
            background: #ff6b6b;
            width: 20px;
            border-radius: 2px;
            margin: 0 auto;
        }
        .social-link {
            display: inline-block;
            margin-right: 8px;
            color: #a29bfe;
            text-decoration: none;
        }
        .social-link:hover { text-decoration: underline; }

        /* Responsividade */
        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                height: 100%;
                width: 300px;
                transform: translateX(-100%);
                z-index: 1000;
                box-shadow: 2px 0 10px rgba(0,0,0,0.5);
            }
            .sidebar.open { transform: translateX(0); }
            .menu-toggle { display: block; }
            .map-container { width: 100%; }
            .modal-content { margin: 10px; max-height: 95vh; }
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useCallback } = React;

        // Coordenadas padrão: Recife, PE
        const DEFAULT_CENTER = [-8.0476, -34.8770];

        // Função para buscar bairros/cidades usando Nominatim
        async function searchLocation(query) {
            if (!query || query.trim() === '') return [];
            const url = `https://nominatim.openstreetmap.org/search?format=json&limit=5&q=${encodeURIComponent(query)}`;
            try {
                const res = await fetch(url, { headers: { 'Accept': 'language' } });
                const data = await res.json();
                return data.map(d => ({
                    display_name: d.display_name,
                    lat: parseFloat(d.lat),
                    lon: parseFloat(d.lon),
                }));
            } catch (e) {
                console.error('Erro na busca:', e);
                return [];
            }
        }

        // Função para buscar POIs via Overpass API (agora inclui tags de contato)
        async function fetchPOIs(lat, lon, radiusKm) {
            const radiusMeters = radiusKm * 1000;
            const query = `
                [out:json][timeout:25];
                (
                    node["amenity"~"bar|pub|nightclub"](around:${radiusMeters},${lat},${lon});
                    node["shop"~"alcohol|beverages|convenience"](around:${radiusMeters},${lat},${lon});
                    node["amenity"="bar"](around:${radiusMeters},${lat},${lon});
                );
                out body;
            `;
            const url = 'https://overpass-api.de/api/interpreter';
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'data=' + encodeURIComponent(query)
                });
                const data = await res.json();
                return data.elements.map(el => ({
                    id: el.id,
                    lat: el.lat,
                    lon: el.lon,
                    name: el.tags?.name || 'Sem nome',
                    type: el.tags?.amenity || el.tags?.shop || 'desconhecido',
                    phone: el.tags?.phone || el.tags?.['contact:phone'] || null,
                    website: el.tags?.website || el.tags?.['contact:website'] || null,
                    instagram: el.tags?.['contact:instagram'] || el.tags?.['instagram'] || null,
                    facebook: el.tags?.['contact:facebook'] || el.tags?.['facebook'] || null,
                    description: el.tags?.description || null,
                }));
            } catch (e) {
                console.error('Erro Overpass:', e);
                return [];
            }
        }

        // Gera dados históricos semanais e calcula tendência
        function generateWeeklyData(baseCrowd) {
            const weeks = [];
            for (let i = 0; i < 8; i++) {
                const variation = Math.floor(Math.random() * 80 - 40);
                weeks.push(Math.max(0, baseCrowd + variation));
            }
            const n = weeks.length;
            const x = Array.from({ length: n }, (_, i) => i);
            const y = weeks;
            const xMean = x.reduce((a, b) => a + b, 0) / n;
            const yMean = y.reduce((a, b) => a + b, 0) / n;
            let num = 0, den = 0;
            for (let i = 0; i < n; i++) {
                num += (x[i] - xMean) * (y[i] - yMean);
                den += (x[i] - xMean) ** 2;
            }
            const slope = den !== 0 ? num / den : 0;
            return { weeks, slope };
        }

        // Tipos de eventos
        const EVENT_TYPES = [
            { type: 'frevo', emoji: '🎺', color: '#ff6b6b' },
            { type: 'festa', emoji: '🎉', color: '#ffd93d' },
            { type: 'automotivo', emoji: '🚗', color: '#6c5ce7' },
            { type: 'funk', emoji: '🔊', color: '#00b894' },
            { type: 'distribuidora', emoji: '🍺', color: '#fd79a8' },
            { type: 'pagode', emoji: '🎸', color: '#e17055' },
            { type: 'brega', emoji: '💃', color: '#a29bfe' },
        ];

        // Componente de detalhes do evento (sem 3D)
        function EventDetailsModal({ event, events, onClose }) {
            // Função para calcular distância entre coordenadas
            const calculateDistance = (lat1, lon1, lat2, lon2) => {
                const R = 6371;
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lon2 - lon1) * Math.PI / 180;
                const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                          Math.sin(dLon/2) * Math.sin(dLon/2);
                return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            };

            // Eventos próximos (até 1 km)
            const nearbyEvents = events
                .filter(ev => ev.id !== event.id)
                .map(ev => ({
                    ...ev,
                    distance: calculateDistance(event.lat, event.lon, ev.lat, ev.lon)
                }))
                .filter(ev => ev.distance <= 1.0)
                .sort((a, b) => a.distance - b.distance);

            // Gerar descrição se não houver
            const description = event.description || 
                `Rolê de ${event.type} com som ao vivo e bebida gelada. Clima animado, presença de público jovem.`;

            return (
                <div className="modal-overlay" onClick={onClose}>
                    <div className="modal-content" onClick={(e) => e.stopPropagation()}>
                        <button className="close-modal" onClick={onClose}>×</button>
                        <h2 style={{ marginTop: 0 }}>{event.emoji} {event.name}</h2>
                        
                        <div className="detail-section">
                            <h3>📋 Informações</h3>
                            <p><strong>Tipo:</strong> {event.type}</p>
                            <p><strong>Pessoas agora:</strong> {event.crowd}</p>
                            <p><strong>Tendência:</strong> {event.trendSlope > 0 ? '📈 Crescendo' : event.trendSlope < 0 ? '📉 Diminuindo' : '➡️ Estável'}</p>
                            <p><strong>Descrição:</strong> {description}</p>
                        </div>

                        <div className="detail-section">
                            <h3>📍 Localização</h3>
                            <p><strong>Coordenadas:</strong> {event.lat.toFixed(6)}, {event.lon.toFixed(6)}</p>
                            <p>
                                <a 
                                    href={`https://www.openstreetmap.org/?mlat=${event.lat}&mlon=${event.lon}#map=18/${event.lat}/${event.lon}`} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    style={{ color: '#a29bfe' }}
                                >
                                    Abrir no OpenStreetMap
                                </a>
                                {' | '}
                                <a 
                                    href={`https://www.google.com/maps?q=${event.lat},${event.lon}`} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    style={{ color: '#a29bfe' }}
                                >
                                    Google Maps
                                </a>
                            </p>
                        </div>

                        <div className="detail-section">
                            <h3>📞 Contatos e Redes Sociais</h3>
                            {event.phone && <p><strong>Telefone:</strong> {event.phone}</p>}
                            {event.website && <p><strong>Site:</strong> <a href={event.website} target="_blank" rel="noopener noreferrer" style={{ color: '#a29bfe' }}>{event.website}</a></p>}
                            {event.instagram && <p><strong>Instagram:</strong> <a href={`https://instagram.com/${event.instagram.replace('@','')}`} target="_blank" rel="noopener noreferrer" className="social-link">@{event.instagram.replace('@','')}</a></p>}
                            {event.facebook && <p><strong>Facebook:</strong> <a href={event.facebook} target="_blank" rel="noopener noreferrer" className="social-link">{event.facebook}</a></p>}
                            {!event.phone && !event.website && !event.instagram && !event.facebook && (
                                <p>Sem contatos disponíveis.</p>
                            )}
                        </div>

                        <div className="detail-section">
                            <h3>🔍 Eventos próximos (até 1 km)</h3>
                            {nearbyEvents.length === 0 ? (
                                <p>Nenhum evento próximo.</p>
                            ) : (
                                <ul style={{ listStyle: 'none', padding: 0 }}>
                                    {nearbyEvents.map(ev => (
                                        <li key={ev.id} style={{ padding: '8px', background: '#1e1e2f', marginBottom: '5px', borderRadius: '4px', display: 'flex', justifyContent: 'space-between' }}>
                                            <span>{ev.emoji} {ev.name} <small>({ev.type})</small></span>
                                            <span>{ev.distance.toFixed(2)} km</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>

                        <div className="detail-section">
                            <h3>📊 Histórico semanal</h3>
                            <div className="weekly-chart">
                                {event.weeklyData.map((val, i) => (
                                    <div key={i} className="weekly-bar">
                                        <div className="bar" style={{ height: `${(val / 200) * 60}px` }}></div>
                                        <small>{val}</small>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // Componente principal
        function App() {
            const [searchQuery, setSearchQuery] = useState('');
            const [searchResults, setSearchResults] = useState([]);
            const [selectedLocation, setSelectedLocation] = useState(null);
            const [radiusKm, setRadiusKm] = useState(2);
            const [userLocation, setUserLocation] = useState(null);
            const [pois, setPois] = useState([]);
            const [events, setEvents] = useState([]);
            const [selectedEvent, setSelectedEvent] = useState(null);
            const [showModal, setShowModal] = useState(false);
            const [isLoading, setIsLoading] = useState(false);
            const [lastUpdate, setLastUpdate] = useState(new Date());
            const [sidebarOpen, setSidebarOpen] = useState(true);

            const mapRef = useRef(null);
            const mapInstance = useRef(null);
            const markersLayer = useRef(null);
            const heatLayer = useRef(null);
            const routeLayer = useRef(null);
            const userMarker = useRef(null);

            // Inicializa o mapa
            useEffect(() => {
                if (!mapInstance.current) {
                    mapInstance.current = L.map('map', {
                        center: DEFAULT_CENTER,
                        zoom: 13,
                        preferCanvas: true,
                    });
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(mapInstance.current);

                    markersLayer.current = L.layerGroup().addTo(mapInstance.current);
                    routeLayer.current = L.layerGroup().addTo(mapInstance.current);

                    // Controle de localização (GPS)
                    mapInstance.current.locate({ setView: false, maxZoom: 16 });
                    mapInstance.current.on('locationfound', (e) => {
                        setUserLocation({ lat: e.latlng.lat, lon: e.latlng.lng });
                        if (userMarker.current) {
                            userMarker.current.setLatLng(e.latlng);
                        } else {
                            userMarker.current = L.circleMarker(e.latlng, {
                                radius: 8,
                                color: '#3498db',
                                fillColor: '#3498db',
                                fillOpacity: 0.8,
                            }).addTo(mapInstance.current);
                            userMarker.current.bindPopup('Você está aqui').openPopup();
                        }
                    });
                    mapInstance.current.on('locationerror', () => {
                        console.log('Localização não disponível');
                    });
                }
                return () => {};
            }, []);

            // Atualiza o mapa quando selectedLocation muda
            useEffect(() => {
                if (selectedLocation && mapInstance.current) {
                    mapInstance.current.setView([selectedLocation.lat, selectedLocation.lon], 13);
                    loadData(selectedLocation.lat, selectedLocation.lon, radiusKm);
                }
            }, [selectedLocation, radiusKm]);

            // Função para carregar POIs e gerar eventos
            const loadData = useCallback(async (lat, lon, radius) => {
                setIsLoading(true);
                setEvents([]);
                setPois([]);
                setSelectedEvent(null);
                setShowModal(false);
                if (routeLayer.current) routeLayer.current.clearLayers();

                const fetchedPOIs = await fetchPOIs(lat, lon, radius);
                setPois(fetchedPOIs);

                const eventList = [];
                const types = EVENT_TYPES.map(t => t.type);
                const shuffled = [...fetchedPOIs].sort(() => Math.random() - 0.5);
                const numEvents = Math.min(5, shuffled.length);
                for (let i = 0; i < numEvents; i++) {
                    const poi = shuffled[i];
                    const eventType = types[Math.floor(Math.random() * types.length)];
                    const baseCrowd = Math.floor(Math.random() * 300) + 50;
                    const { weeks, slope } = generateWeeklyData(baseCrowd);
                    eventList.push({
                        id: `event-${Date.now()}-${i}`,
                        lat: poi.lat,
                        lon: poi.lon,
                        name: poi.name,
                        type: eventType,
                        emoji: EVENT_TYPES.find(t => t.type === eventType)?.emoji || '📍',
                        color: EVENT_TYPES.find(t => t.type === eventType)?.color || '#ff0000',
                        crowd: baseCrowd,
                        weeklyData: weeks,
                        trendSlope: slope,
                        isPOI: true,
                        poiId: poi.id,
                        phone: poi.phone,
                        website: poi.website,
                        instagram: poi.instagram,
                        facebook: poi.facebook,
                        description: poi.description,
                    });
                }

                const extraEvents = 3;
                for (let i = 0; i < extraEvents; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const distance = Math.random() * radius * 1000;
                    const dLat = distance * Math.cos(angle) / 111320;
                    const dLon = distance * Math.sin(angle) / (111320 * Math.cos(lat * Math.PI / 180));
                    const eventLat = lat + dLat;
                    const eventLon = lon + dLon;
                    const eventType = types[Math.floor(Math.random() * types.length)];
                    const baseCrowd = Math.floor(Math.random() * 300) + 50;
                    const { weeks, slope } = generateWeeklyData(baseCrowd);
                    eventList.push({
                        id: `event-extra-${Date.now()}-${i}`,
                        lat: eventLat,
                        lon: eventLon,
                        name: `Evento ${eventType} aleatório`,
                        type: eventType,
                        emoji: EVENT_TYPES.find(t => t.type === eventType)?.emoji || '📍',
                        color: EVENT_TYPES.find(t => t.type === eventType)?.color || '#ff0000',
                        crowd: baseCrowd,
                        weeklyData: weeks,
                        trendSlope: slope,
                        isPOI: false,
                        phone: null,
                        website: null,
                        instagram: null,
                        facebook: null,
                        description: null,
                    });
                }

                setEvents(eventList);
                updateMarkers(eventList, fetchedPOIs);
                updateHeatmap(lat, lon, radius);
                setIsLoading(false);
                setLastUpdate(new Date());
            }, []);

            // Atualiza marcadores no mapa
            const updateMarkers = useCallback((eventsList, poisList) => {
                if (!markersLayer.current) return;
                markersLayer.current.clearLayers();

                poisList.forEach(poi => {
                    const hasEvent = eventsList.some(e => e.poiId === poi.id && e.isPOI);
                    if (!hasEvent) {
                        L.circleMarker([poi.lat, poi.lon], {
                            radius: 5,
                            color: '#888',
                            fillColor: '#aaa',
                            fillOpacity: 0.7,
                        }).addTo(markersLayer.current)
                          .bindPopup(`<b>${poi.name}</b><br>${poi.type}`);
                    }
                });

                eventsList.forEach(event => {
                    const icon = L.divIcon({
                        className: 'event-marker-label',
                        html: `<div style="background:${event.color}; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; border:2px solid white;">${event.emoji}</div>`,
                        iconSize: [30, 30],
                        iconAnchor: [15, 15],
                        popupAnchor: [0, -15],
                    });
                    const marker = L.marker([event.lat, event.lon], { icon }).addTo(markersLayer.current);
                    marker.bindPopup(`
                        <b>${event.name}</b><br>
                        Tipo: ${event.type}<br>
                        Pessoas agora: ${event.crowd}<br>
                        Tendência: ${event.trendSlope > 0 ? '📈 Crescendo' : event.trendSlope < 0 ? '📉 Diminuindo' : '➡️ Estável'}
                    `);
                    marker.on('click', () => handleEventSelect(event));
                });
            }, []);

            // Atualiza mapa de calor (tráfego)
            const updateHeatmap = useCallback((lat, lon, radius) => {
                if (!mapInstance.current) return;
                if (heatLayer.current) {
                    mapInstance.current.removeLayer(heatLayer.current);
                }
                const points = [];
                const numPoints = 50;
                for (let i = 0; i < numPoints; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const dist = Math.random() * radius * 1000 * 0.6;
                    const dLat = dist * Math.cos(angle) / 111320;
                    const dLon = dist * Math.sin(angle) / (111320 * Math.cos(lat * Math.PI / 180));
                    const intensity = Math.random();
                    points.push([lat + dLat, lon + dLon, intensity]);
                }
                heatLayer.current = L.heatLayer(points, {
                    radius: 25,
                    blur: 15,
                    maxZoom: 17,
                    gradient: {0.2: 'blue', 0.4: 'lime', 0.6: 'yellow', 0.8: 'orange', 1: 'red'}
                }).addTo(mapInstance.current);
            }, []);

            // Atualização em tempo real (simulada)
            useEffect(() => {
                if (events.length === 0) return;
                const interval = setInterval(() => {
                    setEvents(prev => prev.map(ev => ({
                        ...ev,
                        crowd: Math.max(0, ev.crowd + Math.floor(Math.random() * 30 - 15)),
                        trendSlope: ev.trendSlope + (Math.random() * 0.4 - 0.2),
                    })));
                    setLastUpdate(new Date());
                }, 3000);
                return () => clearInterval(interval);
            }, [events.length]);

            // Atualiza marcadores quando eventos mudam
            useEffect(() => {
                if (events.length > 0 && pois.length >= 0) {
                    updateMarkers(events, pois);
                }
            }, [events, pois, updateMarkers]);

            // Atualiza mapa de calor periodicamente
            useEffect(() => {
                if (selectedLocation) {
                    const interval = setInterval(() => {
                        updateHeatmap(selectedLocation.lat, selectedLocation.lon, radiusKm);
                    }, 10000);
                    return () => clearInterval(interval);
                }
            }, [selectedLocation, radiusKm, updateHeatmap]);

            // Manipula seleção de evento
            const handleEventSelect = useCallback(async (event) => {
                setSelectedEvent(event);
                setShowModal(true);
                // Calcula rota se tiver localização do usuário
                if (userLocation) {
                    try {
                        const routeUrl = `https://router.project-osrm.org/route/v1/driving/${userLocation.lon},${userLocation.lat};${event.lon},${event.lat}?overview=full&geometries=geojson`;
                        const res = await fetch(routeUrl);
                        const data = await res.json();
                        if (data.routes && data.routes.length > 0) {
                            const route = data.routes[0];
                            const distanceKm = (route.distance / 1000).toFixed(2);
                            const durationMin = Math.round(route.duration / 60);
                            setRouteInfo({ distanceKm, durationMin, geometry: route.geometry });
                            if (routeLayer.current) {
                                routeLayer.current.clearLayers();
                                const coords = route.geometry.coordinates.map(c => [c[1], c[0]]);
                                L.polyline(coords, { color: '#3498db', weight: 5, opacity: 0.8 }).addTo(routeLayer.current);
                                mapInstance.current.fitBounds(L.polyline(coords).getBounds(), { padding: [50, 50] });
                            }
                        }
                    } catch (e) {
                        console.error('Erro na rota:', e);
                        setRouteInfo(null);
                    }
                } else {
                    setRouteInfo(null);
                }
            }, [userLocation]);

            // Manipula pesquisa de local
            const handleSearch = async (e) => {
                e.preventDefault();
                if (!searchQuery.trim()) return;
                const results = await searchLocation(searchQuery);
                setSearchResults(results);
            };

            const handleSelectLocation = (loc) => {
                setSelectedLocation({ lat: loc.lat, lon: loc.lon, name: loc.display_name });
                setSearchResults([]);
                setSearchQuery(loc.display_name);
                if (window.innerWidth <= 768) {
                    setSidebarOpen(false);
                }
            };

            const handleLocateUser = () => {
                if (userLocation && mapInstance.current) {
                    mapInstance.current.setView([userLocation.lat, userLocation.lon], 15);
                    setSelectedLocation({ lat: userLocation.lat, lon: userLocation.lon, name: 'Minha localização' });
                    setRadiusKm(2);
                } else {
                    alert('Localização ainda não disponível.');
                }
            };

            const [routeInfo, setRouteInfo] = useState(null);

            return (
                <div className="app-container">
                    <button className="menu-toggle" onClick={() => setSidebarOpen(!sidebarOpen)}>
                        {sidebarOpen ? '✕' : '☰'}
                    </button>
                    <div className={`sidebar ${sidebarOpen ? 'open' : ''}`}>
                        <h2>🎉 Mapa de Rolês - Frevos, Festas e Funk</h2>
                        
                        <form onSubmit={handleSearch}>
                            <input
                                type="text"
                                className="search-box"
                                placeholder="Pesquisar bairro/cidade..."
                                value={searchQuery}
                                onChange={(e) => setSearchQuery(e.target.value)}
                            />
                        </form>
                        {searchResults.length > 0 && (
                            <ul className="search-results">
                                {searchResults.map((res, idx) => (
                                    <li key={idx} onClick={() => handleSelectLocation(res)}>
                                        📍 {res.display_name}
                                    </li>
                                ))}
                            </ul>
                        )}

                        <div className="radius-buttons">
                            <button
                                className={radiusKm === 0.2 ? 'active' : ''}
                                onClick={() => setRadiusKm(0.2)}
                            >
                                0,2 km
                            </button>
                            <button
                                className={radiusKm === 2 ? 'active' : ''}
                                onClick={() => setRadiusKm(2)}
                            >
                                2 km
                            </button>
                        </div>

                        <button
                            onClick={handleLocateUser}
                            style={{ width: '100%', padding: '10px', background: '#3498db', color: '#fff', border: 'none', borderRadius: '5px', cursor: 'pointer', marginBottom: '10px' }}
                        >
                            📡 Centralizar na minha localização
                        </button>

                        {selectedLocation && (
                            <div className="info-panel">
                                <strong>📍 Região selecionada:</strong>
                                <br />
                                {selectedLocation.name}
                                <br />
                                <small>Lat: {selectedLocation.lat.toFixed(5)}, Lon: {selectedLocation.lon.toFixed(5)}</small>
                            </div>
                        )}

                        {isLoading ? (
                            <div className="loading">Carregando dados...</div>
                        ) : (
                            <>
                                <h3 style={{ marginTop: '15px' }}>🎶 Eventos detectados ({events.length})</h3>
                                {events.map(ev => (
                                    <div
                                        key={ev.id}
                                        className="event-item"
                                        onClick={() => handleEventSelect(ev)}
                                        style={{ borderLeft: `4px solid ${ev.color}` }}
                                    >
                                        <span>{ev.emoji} {ev.name} <small>({ev.type})</small></span>
                                        <span>👥 {ev.crowd}</span>
                                    </div>
                                ))}

                                <div className="stats">
                                    <div className="stat-card">
                                        <div>📍 POIs</div>
                                        <div>{pois.length}</div>
                                    </div>
                                    <div className="stat-card">
                                        <div>🎤 Eventos</div>
                                        <div>{events.length}</div>
                                    </div>
                                    <div className="stat-card">
                                        <div>🕒 Atualizado</div>
                                        <div>{lastUpdate.toLocaleTimeString()}</div>
                                    </div>
                                </div>
                            </>
                        )}
                    </div>
                    <div className="map-container">
                        <div id="map" style={{ width: '100%', height: '100%' }}></div>
                    </div>

                    {showModal && selectedEvent && (
                        <EventDetailsModal 
                            event={selectedEvent} 
                            events={events} 
                            onClose={() => setShowModal(false)} 
                        />
                    )}
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
